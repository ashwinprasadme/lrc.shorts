# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM ──────────────────────────────────────────────────────────────────────
# Model string passed to litellm — any provider litellm supports.
LITELLM_MODEL=gemini/gemini-2.0-flash

# API key for the chosen provider (set the one that matches LITELLM_MODEL)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# How many hours back to search when expanding a story's article list
ARTICLE_EXPAND_HOURS=48

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000

# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=change-me-in-production
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# ── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated list of allowed Telegram user IDs (leave empty to allow all)
TELEGRAM_ALLOWED_USERS=
